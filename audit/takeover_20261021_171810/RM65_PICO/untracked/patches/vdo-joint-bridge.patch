+    def send_stream(self, payload: dict[str, Any], *, timeout_s: float = 0.1) -> None:
+        """Bounded send-only CANFD frame; uses the same socket/parser lock.
+
+        This confirms local sending, not controller acknowledgement or motion.
+        """
+        if payload.get("command") not in {"movej_canfd", "movep_canfd"}:
+            raise ValueError("send_stream only accepts CANFD motion frames")
+        line=json.dumps(payload,separators=(",",":"),allow_nan=False).encode()+b"\r\n"
+        if not self._lock.acquire(timeout=timeout_s):
+            raise TimeoutError("Controller stream lock deadline exceeded")
+        try:
+            previous=self._sock.gettimeout()
+            try:
+                self._sock.settimeout(timeout_s)
+                self._sock.sendall(line)
+            finally:
+                self._sock.settimeout(previous)
+        finally:
+            self._lock.release()
 
