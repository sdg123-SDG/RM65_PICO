<!-- Custom RM65 tabletop scene: Gemini335 eye-in-hand variant. -->
<mujoco model="custom_rm65_box_scene_gemini">
  <compiler angle="radian" balanceinertia="true" autolimits="true"/>
  <option integrator="implicitfast" cone="elliptic" impratio="10" timestep="0.002"/>
  <statistic center="0.22 0 1.05" extent="1.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="145" elevation="-18"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient"
             rgb1="0.30 0.50 0.70" rgb2="0 0 0"
             width="512" height="3072"/>

    <texture type="2d" name="groundplane"
             builtin="checker" mark="edge"
             rgb1="0.20 0.30 0.40"
             rgb2="0.10 0.20 0.30"
             markrgb="0.8 0.8 0.8"
             width="300" height="300"/>

    <material name="mat_groundplane"
              texture="groundplane"
              texuniform="true"
              texrepeat="5 5"
              reflectance="0.2"/>

    <!-- Gemini variant: original scene.xml keeps loading rm65b.xml. -->
    <model name="rm65b" file="../../objects/rm65b/rm65b_gemini.xml"/>
  </asset>

  <worldbody>
    <light pos="0 0 2.8"
           dir="0 0 -1"
           directional="true"/>

    <geom name="floor"
          type="plane"
          size="0 0 0.05"
          material="mat_groundplane"
          contype="1"
          conaffinity="1"
          condim="3"
          friction="1.0 0.005 0.0001"/>

    <!-- Tabletop mount: URDF +Z-up on the 0.70 m table surface. -->
    <body name="rm65_mount" pos="0 0 0.70">
      <attach model="rm65b" body="base_link" prefix=""/>
    </body>
  </worldbody>

  <include file="../../objects/table/table.xml"/>
  <include file="../../objects/wood_box_container_rm65/wood_box_container_rm65.xml"/>
  <include file="../../objects/wood_box_rm65/wood_box_rm65.xml"/>
  <!-- EE above the +X box, flange Z down. q: J2/J3/J5; ctrl holds the pose. -->
  <keyframe>
    <key name="home"
         qpos="0 -0.0837 -1.1556 0 -1.9023 0 0 0 0.22 0 0.745 1 0 0 0"
         ctrl="0 -0.0837 -1.1556 0 -1.9023 0 0"/>
  </keyframe>
</mujoco>
