  <contact>
    <exclude body1="base_link" body2="link_1"/>
    <exclude body1="link_1" body2="link_2"/>
    <exclude body1="link_2" body2="link_3"/>
    <exclude body1="link_3" body2="link_4"/>
    <exclude body1="link_4" body2="link_5"/>
    <exclude body1="link_5" body2="link_6"/>
    <exclude body1="link_6" body2="flange"/>
    <exclude body1="flange" body2="gripper_link1"/>
    <exclude body1="gripper_link1" body2="gripper_link3"/>
    <exclude body1="flange" body2="gripper_link2"/>
    <exclude body1="gripper_link2" body2="gripper_link4"/>
  </contact>
</mujoco>
