<!-- Historical backup: RM65-B + four-bar gripper, gravcomp=1.
     Active model is rm65b_gravcomp.xml (RMG24). -->
<mujoco model="rm65b_gravcomp">
  <compiler balanceinertia="true" angle="radian" autolimits="true"/>
  <default>
    <default class="robot">
      <default class="motor">
        <joint/>
        <motor/>
      </default>
      <default class="visual">
        <geom material="rm65_shell" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <!-- group 3: arm + gripper collide with world (group 1) and non-adjacent robot
             parts. Adjacent overlapping meshes are listed in <contact><exclude>. -->
        <geom material="collision_material" condim="3" contype="1" conaffinity="1" priority="1" group="3"
              solref="0.005 1" solimp="0.99 0.999 1e-05" friction="1 0.01 0.01"/>
      </default>
    </default>
  </default>

  <asset>
    <texture type="2d" name="tex_rm65_shell" file="textures/rm65_shell.png"/>
    <texture type="2d" name="tex_rm65_base" file="textures/rm65_base.png"/>
    <texture type="2d" name="tex_rm65_joint" file="textures/rm65_joint.png"/>
    <texture type="2d" name="tex_rm65_gripper" file="textures/rm65_gripper.png"/>
    <material name="default_material" rgba="0.91 0.92 0.94 1"/>
    <material name="collision_material" rgba="1.0 0.28 0.1 0.9"/>
    <material name="visualgeom" texture="tex_rm65_shell" texuniform="false" rgba="1 1 1 1"
              reflectance="0.08" shininess="0.18" specular="0.28" roughness="0.55" metallic="0.04"/>
    <material name="rm65_shell" texture="tex_rm65_shell" texuniform="false" rgba="1 1 1 1"
              reflectance="0.08" shininess="0.18" specular="0.28" roughness="0.55" metallic="0.04"/>
    <material name="rm65_base" texture="tex_rm65_base" texuniform="false" rgba="1 1 1 1"
              reflectance="0.08" shininess="0.18" specular="0.28" roughness="0.55" metallic="0.04"/>
    <material name="rm65_joint" texture="tex_rm65_joint" texuniform="false" rgba="1 1 1 1"
              reflectance="0.04" shininess="0.12" specular="0.16" roughness="0.72" metallic="0.02"/>
    <material name="rm65_gripper" texture="tex_rm65_gripper" texuniform="false" rgba="1 1 1 1"
              reflectance="0.05" shininess="0.14" specular="0.18" roughness="0.68" metallic="0.03"/>
    <mesh name="base_link.STL" file="meshes/base_link.STL"/>
    <mesh name="link_1.STL" file="meshes/link_1.STL"/>
    <mesh name="link_2.STL" file="meshes/link_2.STL"/>
    <mesh name="link_3.STL" file="meshes/link_3.STL"/>
    <mesh name="link_4.STL" file="meshes/link_4.STL"/>
    <mesh name="link_5.STL" file="meshes/link_5.STL"/>
    <mesh name="link_6.STL" file="meshes/link_6.STL"/>
    <mesh name="gripper_base_link.STL" file="meshes/gripper/base_link.STL"/>
    <mesh name="gripper_link_1.STL" file="meshes/gripper/Link1.STL"/>
    <mesh name="gripper_link_2.STL" file="meshes/gripper/Link2.STL"/>
    <mesh name="gripper_link_3.STL" file="meshes/gripper/Link3.STL"/>
    <mesh name="gripper_link_4.STL" file="meshes/gripper/Link4.STL"/>
    <mesh name="base_link_vis" file="meshes/visual/base_link.obj"/>
    <mesh name="link_1_vis" file="meshes/visual/link_1.obj"/>
    <mesh name="link_2_vis" file="meshes/visual/link_2.obj"/>
    <mesh name="link_3_vis" file="meshes/visual/link_3.obj"/>
    <mesh name="link_4_vis" file="meshes/visual/link_4.obj"/>
    <mesh name="link_5_vis" file="meshes/visual/link_5.obj"/>
    <mesh name="link_6_vis" file="meshes/visual/link_6.obj"/>
    <mesh name="gripper_base_link_vis" file="meshes/visual/gripper_base_link.obj"/>
    <mesh name="gripper_link_1_vis" file="meshes/visual/gripper_link_1.obj"/>
    <mesh name="gripper_link_2_vis" file="meshes/visual/gripper_link_2.obj"/>
    <mesh name="gripper_link_3_vis" file="meshes/visual/gripper_link_3.obj"/>
    <mesh name="gripper_link_4_vis" file="meshes/visual/gripper_link_4.obj"/>
  </asset>

  <worldbody>
    <body name="base_link" childclass="robot">
      <inertial pos="-0.00049987 -5.2709e-05 0.060019" mass="1.862" fullinertia="0.0017232 0.0017051 0.00090158 -3.1058e-06 3.7924e-05 -1.3691e-06"/>
      <geom name="base_link_collision" type="mesh" mesh="base_link.STL" class="collision"/>
      <geom name="base_link_visual" type="mesh" mesh="base_link_vis" class="visual" material="rm65_base"/>
      <!-- Robot-frame triad at the URDF/MJCF origin: X red, Y green, Z blue. -->
      <geom name="base_axis_x" type="cylinder" fromto="0 0 0 0.08 0 0" size="0.0025"
            rgba="1 0.12 0.12 1" contype="0" conaffinity="0" group="2" density="0"/>
      <geom name="base_axis_x_tip" type="cylinder" fromto="0.08 0 0 0.11 0 0" size="0.0055"
            rgba="1 0.12 0.12 1" contype="0" conaffinity="0" group="2" density="0"/>
      <geom name="base_axis_y" type="cylinder" fromto="0 0 0 0 0.08 0" size="0.0025"
            rgba="0.15 0.85 0.2 1" contype="0" conaffinity="0" group="2" density="0"/>
      <geom name="base_axis_y_tip" type="cylinder" fromto="0 0.08 0 0 0.11 0" size="0.0055"
            rgba="0.15 0.85 0.2 1" contype="0" conaffinity="0" group="2" density="0"/>
      <geom name="base_axis_z" type="cylinder" fromto="0 0 0 0 0 0.08" size="0.0025"
            rgba="0.2 0.4 1 1" contype="0" conaffinity="0" group="2" density="0"/>
      <geom name="base_axis_z_tip" type="cylinder" fromto="0 0 0.08 0 0 0.11" size="0.0055"
            rgba="0.2 0.4 1 1" contype="0" conaffinity="0" group="2" density="0"/>
      <body name="link_1" gravcomp="1" pos="0 0 0.2405">
        <!-- armature = n^2 J_m at the output (WHJ60 100:1 J1-2, WHJ30 80:1 J3, WHJ10 80:1 J4-6). -->
        <joint name="joint_1" type="hinge" ref="0.0" class="motor" range="-3.106686 3.106686" axis="0 0 1" damping="0.08" armature="0.551" frictionloss="0.05"/>
        <inertial pos="0.000491 0.007803 -0.010744" mass="1.51" fullinertia="0.002662222 0.002331681 0.001663714 -2.684478e-05 -1.378171e-05 -7.866650e-05"/>
        <geom name="link_1_collision" type="mesh" mesh="link_1.STL" class="collision"/>
        <geom name="link_1_visual" type="mesh" mesh="link_1_vis" class="visual" material="rm65_shell"/>
        <body name="link_2" gravcomp="1" pos="0 0 0" quat="0.4999981633974483 0.49999999999662686 -0.49999999999662686 0.5000018366025516">
          <joint name="joint_2" type="hinge" ref="0.0" class="motor" range="-2.268928 2.268928" axis="0 0 1" damping="0.08" armature="0.551" frictionloss="0.05"/>
