                  <body name="flange" gravcomp="1" pos="0.00 -0.01 0.03" quat="1 1 -1 1" childclass="robot">
                    <site name="flange_site" pos="0 0 0" size="0.01"/>
                    <include file="gripper_rm65_legacy_gravcomp.xml"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
      <site name="base_link_site" pos="0 0 0"/>
    </body>
  </worldbody>

  <actuator>
    <position name="joint_1_ctrl" joint="joint_1" kp="140" dampratio="1.0" forcerange="-60 60" ctrlrange="-3.106686 3.106686"/>
    <position name="joint_2_ctrl" joint="joint_2" kp="140" dampratio="1.0" forcerange="-60 60" ctrlrange="-2.268928 2.268928"/>
    <position name="joint_3_ctrl" joint="joint_3" kp="120" dampratio="1.0" forcerange="-30 30" ctrlrange="-2.356194 2.356194"/>
    <position name="joint_4_ctrl" joint="joint_4" kp="80" dampratio="1.0" forcerange="-10 10" ctrlrange="-3.106686 3.106686"/>
    <position name="joint_5_ctrl" joint="joint_5" kp="70" dampratio="1.0" forcerange="-10 10" ctrlrange="-2.234021 2.234021"/>
    <position name="joint_6_ctrl" joint="joint_6" kp="60" dampratio="1.0" forcerange="-10 10" ctrlrange="-6.283185 6.283185"/>

    <position name="gripper_b1_ctrl"  joint="joint_b1" kp="25" dampratio="1.0" forcerange="-8 8"/>
    <position name="gripper_13_ctrl"  joint="joint_13" kp="20" dampratio="1.0" forcerange="-5 5"/>
    <position name="gripper_b2_ctrl"  joint="joint_b2" kp="25" dampratio="1.0" forcerange="-8 8"/>
    <position name="gripper_24_ctrl"  joint="joint_24" kp="20" dampratio="1.0" forcerange="-5 5"/>
