          <geom name="link_2_collision" type="mesh" mesh="link_2.STL" class="collision"/>
          <geom name="link_2_visual" type="mesh" mesh="link_2_vis" class="visual" material="rm65_shell"/>
          <body name="link_3" gravcomp="1" pos="0.256 0 0" quat="0.7071054825112363 0.0 0.0 0.7071080798594735">
            <joint name="joint_3" type="hinge" ref="0.0" class="motor" range="-2.356194 2.356194" axis="0 0 1" damping="0.08" armature="0.191" frictionloss="0.05"/>
            <inertial pos="0.000029 -0.090105 0.004039" mass="0.726" fullinertia="0.001353711 0.000360028 0.001334428 1.096929e-06 -2.289629e-07 -0.000219765"/>
            <geom name="link_3_collision" type="mesh" mesh="link_3.STL" class="collision"/>
            <geom name="link_3_visual" type="mesh" mesh="link_3_vis" class="visual" material="rm65_shell"/>
            <body name="link_4" gravcomp="1" pos="0 -0.21 0" quat="0.7071054825112363 0.7071080798594735 0.0 0.0">
              <joint name="joint_4" type="hinge" ref="0.0" class="motor" range="-3.106686 3.106686" axis="0 0 1" damping="0.08" armature="0.072" frictionloss="0.05"/>
              <inertial pos="0.000007 -0.009486 -0.008041" mass="0.671" fullinertia="0.000690249 0.000552850 0.000425849 -8.655557e-07 -6.927686e-07 1.639682e-05"/>
              <geom name="link_4_collision" type="mesh" mesh="link_4.STL" class="collision"/>
              <geom name="link_4_visual" type="mesh" mesh="link_4_vis" class="visual" material="rm65_shell"/>
              <body name="link_5" gravcomp="1" pos="0 0 0" quat="0.7071054825112363 -0.7071080798594735 0.0 0.0">
                <joint name="joint_5" type="hinge" ref="0.0" class="motor" range="-2.234021 2.234021" axis="0 0 1" damping="0.08" armature="0.072" frictionloss="0.05"/>
                <inertial pos="0.000032 -0.083769 0.002326" mass="0.647" fullinertia="0.000831946 0.000281764 0.000819611 9.306466e-07 -2.558425e-07 -0.000111831"/>
                <geom name="link_5_collision" type="mesh" mesh="link_5.STL" class="collision"/>
                <geom name="link_5_visual" type="mesh" mesh="link_5_vis" class="visual" material="rm65_shell"/>
                <body name="link_6" gravcomp="1" pos="0 -0.144 0" quat="0.7071054825112363 0.7071080798594735 0.0 0.0">
                  <joint name="joint_6" type="hinge" ref="0.0" class="motor" range="-6.283185 6.283185" axis="0 0 1" damping="0.08" armature="0.072" frictionloss="0.05"/>
                  <inertial pos="-0.000506 0.000255 -0.010801" mass="0.107" fullinertia="3.842825e-05 3.490981e-05 6.031565e-05 -3.149806e-06 -1.142123e-07 9.329472e-08"/>
                  <geom name="link_6_collision" type="mesh" mesh="link_6.STL" class="collision"/>
                  <geom name="link_6_visual" type="mesh" mesh="link_6_vis" class="visual" material="rm65_shell"/>
                  <!-- IK / xbox ee 法兰系（link_6，不是 MJCF flange 子体）：X 红=左杆前，Y 绿=左杆右，Z 蓝=RT。 -->
                  <geom name="ee_axis_x" type="cylinder" fromto="0 0 0 0.08 0 0" size="0.0025"
                        rgba="1 0.12 0.12 1" contype="0" conaffinity="0" group="2" density="0"/>
                  <geom name="ee_axis_x_tip" type="cylinder" fromto="0.08 0 0 0.11 0 0" size="0.0055"
                        rgba="1 0.12 0.12 1" contype="0" conaffinity="0" group="2" density="0"/>
                  <geom name="ee_axis_y" type="cylinder" fromto="0 0 0 0 0.08 0" size="0.0025"
                        rgba="0.15 0.85 0.2 1" contype="0" conaffinity="0" group="2" density="0"/>
                  <geom name="ee_axis_y_tip" type="cylinder" fromto="0 0.08 0 0 0.11 0" size="0.0055"
