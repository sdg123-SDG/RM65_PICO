<!-- Open-top wooden container, just larger than the RM65-sized wooden box. -->
<mujoco model="wood_box_container_rm65">
  <compiler angle="radian" autolimits="true"/>
  <default>
    <default class="container_static">
      <geom contype="1" conaffinity="1" group="1" condim="3" friction="0.9 0.01 0.01"/>
    </default>
  </default>
  <asset>
    <material name="mat_container_outer" rgba="0.30 0.095 0.022 1" shininess="0.12"/>
    <material name="mat_container_inner" rgba="0.12 0.030 0.008 1"/>
    <material name="mat_container_rim" rgba="0.63 0.29 0.065 1" shininess="0.18"/>
  </asset>
  <worldbody>
    <!-- Outer size 0.070 x 0.070 m; inner square opening 0.058 x 0.058 m. -->
    <!-- Same +X line as the box; farther from the base. -->
    <body name="wood_box_container_rm65" pos="0.42 0 0.70">
      <geom name="container_floor" type="box" class="container_static" material="mat_container_inner"
            pos="0 0 0.006" size="0.035 0.035 0.006"/>
      <geom name="container_left" type="box" class="container_static" material="mat_container_outer"
            pos="-0.032 0 0.020" size="0.003 0.035 0.020"/>
      <geom name="container_right" type="box" class="container_static" material="mat_container_outer"
            pos="0.032 0 0.020" size="0.003 0.035 0.020"/>
      <geom name="container_front" type="box" class="container_static" material="mat_container_outer"
            pos="0 -0.032 0.020" size="0.032 0.003 0.020"/>
      <geom name="container_back" type="box" class="container_static" material="mat_container_outer"
            pos="0 0.032 0.020" size="0.032 0.003 0.020"/>
      <geom name="container_rim_front" type="box" class="container_static" material="mat_container_rim"
            pos="0 -0.032 0.041" size="0.032 0.003 0.002"/>
      <geom name="container_rim_back" type="box" class="container_static" material="mat_container_rim"
            pos="0 0.032 0.041" size="0.032 0.003 0.002"/>
    </body>
  </worldbody>
</mujoco>
